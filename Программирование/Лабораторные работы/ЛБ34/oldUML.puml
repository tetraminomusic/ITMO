@startuml

class mrazi.Shrimp {
- {static} int shrimpCounter
}

class footbolchik.GameSetup {
- Field field
+ void ResetRound()
- int SpawnWidth()
- int SpawnHeight()
+ void initializeGame(int,int)
}

abstract class mrazi.Player {
# double confidence
# boolean hasBall
# String name
+ boolean hasBall()
+ void setHasBall(boolean)
+ double getConfidence()
+ void increaseConfidence(double)
+ void decreaseConfidence(double)
+ String getName()
+ Player pass(java.util.List<Player>,double)
+ boolean shoot(int,int)
}

class footbolchik.RunTurn {
- Field field
- Random random
~ Music trap
~ Music goal
~ Music lox
+ void playTurn()
}

class muzlo.Mp3Player {
- String filename
- Player player
- Thread playerThread
- boolean loop
+ void play()
+ void close()
}

class muzlo.Music {
- {static} Mp3Player goalMp3Player
- {static} Mp3Player backgroundMp3Player
- String nameFile
- boolean loop
+ Mp3Player getGoalMp3Player()
+ Mp3Player getBackgroundMp3Player()
+ void playSound()
+ void stopSound()
+ {static} void stopAllMusic()
}

class footbolchik.Field {
